	agent any
	stages {
	
		stage("Build"){
			steps {
				echo 'building the application...'
			}
		
		}
		
		stage("Test"){
			steps {
				echo 'testing the application...'
			}
		
		}
		
		stage("Deploy"){
			steps {
				echo 'deploying the app...'
			}
		
		}
        stage("Saying hooray"){
			steps {
				echo 'HOORAY!!!'
			}
		
		}
        stage("Checking auto trigger"){
			steps {
				echo 'Gratar bomba!!!'
			}
		
		}
	
	}
}
